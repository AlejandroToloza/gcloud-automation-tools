# Copia este archivo a ".env" y completa tus datos para evitar que los
# scripts te los pidan por consola en cada ejecución (necesario para correr
# los scripts sin intervención humana, por ejemplo desde una tarea programada).
GENESYS_CLIENT_ID=tu_client_id
GENESYS_CLIENT_SECRET=tu_client_secret

# Número de región de Genesys Cloud (evita el menú interactivo). Valores:
# 1=Estados Unidos (Este)      5=EMEA (Dublín)
# 2=Estados Unidos (Oeste)     6=EMEA (Fráncfort)
# 3=Américas (Canadá)          7=Asia Pacífico (Tokio)
# 4=América (Sao Paulo)        8=Asia Pacífico (Sydney)
GENESYS_REGION=1

# Solo para scripts de escritura en bulk (ej. scripts/bulk_actualizar_usuarios).
# BULK_ARCHIVO_CSV: ruta al CSV con los cambios a aplicar.
# BULK_CONFIRM=1: aplica los cambios de verdad. Sin esto, el script SIEMPRE
# se queda en modo vista previa (dry-run) y no escribe nada.
# BULK_ARCHIVO_CSV=cambios.csv
# BULK_CONFIRM=1
